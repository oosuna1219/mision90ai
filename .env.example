# Fase 2 — variables de entorno (copiar a .env y llenar). NUNCA commitear .env.

# Postgres (EasyPanel te da la URL al crear el servicio de base de datos)
DATABASE_URL="postgresql://usuario:password@host:5432/mision90ai?schema=public"

# Sesión JWT httpOnly — genera un secreto largo y aleatorio
JWT_SECRET="cambia-esto-por-un-secreto-largo-aleatorio"

# WhatsApp vía WAHA (ya corre en tu VPS) — para enviar los códigos OTP
WAHA_URL="http://discount-auto-brokers_waha:3000"
WAHA_SESSION="default"
WAHA_API_KEY=""

# Coach IA (llamadas server-side). Anthropic Claude por defecto.
# Opcional: COACH_MODEL=claude-haiku-4-5 (o claude-sonnet-5) para bajar costo.
ANTHROPIC_API_KEY=""
COACH_MODEL="claude-opus-5"

# Almacenamiento privado de fotos (bucket S3-compatible, URLs firmadas)
S3_ENDPOINT=""
S3_BUCKET="mision90-fotos"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
